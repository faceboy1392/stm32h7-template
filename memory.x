MEMORY
{
  /* note, this file was generated by claude, which was directly given the relevant pages of the reference manual. */
  /* Required by cortex-m-rt */
  FLASH  : ORIGIN = 0x08000000, LENGTH = 2048K  /* Bank 1 + Bank 2, 1M each */
  RAM    : ORIGIN = 0x24000000, LENGTH = 512K   /* AXI SRAM: reachable by DMA1/2 and MDMA */

  /* Extra regions, used by placing data there explicitly */
  ITCM    : ORIGIN = 0x00000000, LENGTH = 64K    /* Fast code; CPU and MDMA only */
  DTCM    : ORIGIN = 0x20000000, LENGTH = 128K   /* Fast data; NOT reachable by DMA1/2 */
  SRAM1   : ORIGIN = 0x30000000, LENGTH = 128K   /* D2 domain */
  SRAM2   : ORIGIN = 0x30020000, LENGTH = 128K   /* D2 domain */
  SRAM3   : ORIGIN = 0x30040000, LENGTH = 32K    /* D2 domain */
  SRAM4   : ORIGIN = 0x38000000, LENGTH = 64K    /* D3 domain: the only RAM BDMA can use */
  BKPSRAM : ORIGIN = 0x38800000, LENGTH = 4K     /* Survives reset; needs PWR/RCC setup */
}